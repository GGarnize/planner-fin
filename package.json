{
  "name": "planner-fin",
  "private": true,
  "version": "0.0.0",
  "description": "Scaffold técnico inicial do PlannerFin.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @planner-fin/api --filter @planner-fin/web dev",
    "dev:api": "pnpm --filter @planner-fin/api dev",
    "dev:web": "pnpm --filter @planner-fin/web dev",
    "dev:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/dev-android.ps1",
    "dev:android:services": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/dev-android.ps1 -SkipEmulator",
    "dev:phone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/dev-android.ps1 -SkipEmulator -PhoneMode",
    "dev:android:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/stop.ps1",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/build-apk.ps1 -Target emulator",
    "android:apk:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/build-apk.ps1 -Target lan",
    "android:apk:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/build-apk.ps1 -Target remote",
    "android:apk:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/serve-apk.ps1",
    "android:bundle": "pnpm --filter @planner-fin/web android:bundle:release",
    "android:bundle:release": "pnpm --filter @planner-fin/web android:bundle:release",
    "dev:seed-test-user": "pnpm --filter @planner-fin/api dev:seed-test-user",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @planner-fin/shared build && pnpm --filter @planner-fin/config build && pnpm -r typecheck",
    "test": "pnpm test:dx && pnpm --filter @planner-fin/shared build && pnpm -r test",
    "test:dx": "node --test scripts/android/*.test.mjs apps/api/scripts/*.test.mjs apps/web/scripts/*.test.mjs",
    "test:unit": "pnpm --filter @planner-fin/shared build && pnpm -r test:unit",
    "test:e2e": "pnpm --filter @planner-fin/web test:e2e",
    "test:android:notifications": "node scripts/android/test-notifications.mjs",
    "test:android:notifications:integrated": "node scripts/android/test-notifications-integrated.mjs",
    "android:validate": "pnpm --filter @planner-fin/web android:validate",
    "android:sync": "pnpm --filter @planner-fin/web android:sync",
    "android:open": "pnpm --filter @planner-fin/web android:open",
    "android:build:debug": "pnpm --filter @planner-fin/web android:build:debug",
    "android:build:internal": "pnpm --filter @planner-fin/web android:build:internal",
    "android:release:build": "pnpm --filter @planner-fin/web android:release:build",
    "android:release:publish": "pnpm --filter @planner-fin/web android:release:publish",
    "android:release:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.ps1 -Command setup",
    "android:release:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.ps1 -Command doctor",
    "android:release:secrets:selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/windows-credentials.selftest.ps1",
    "android:release:lib:selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.lib.selftest.ps1",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.ps1 -Command release",
    "android:release:commit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.ps1 -Command commit",
    "android:release:commit:selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.commit.selftest.ps1",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @planner-fin/api db:migrate",
    "db:generate": "pnpm --filter @planner-fin/api db:generate",
    "db": "pnpm db:generate && pnpm db:migrate",
    "build:prod": "pnpm --filter @planner-fin/shared build && pnpm --filter @planner-fin/api build && pnpm --filter @planner-fin/web build:prod",
    "start:api:prod": "pnpm --filter @planner-fin/api start:prod",
    "start:web:prod": "pnpm --filter @planner-fin/web start:prod",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.0"
  }
}
