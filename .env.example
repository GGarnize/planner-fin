# Exemplos locais sem segredos reais.
DATABASE_URL="postgresql://planner_fin_local:planner_fin_local@localhost:5432/planner_fin_local?schema=public"
API_PORT=3000
API_CORS_ORIGINS=http://localhost:9000,https://localhost
VITE_API_BASE_URL=http://localhost:3000/api
JWT_SECRET=synthetic-local-key-32-bytes-minimum-do-not-reuse
REFRESH_HMAC_SECRET=another-synthetic-local-key-32-bytes-do-not-reuse
JWT_ISSUER=planner-fin-api
JWT_AUDIENCE=planner-fin-web
COOKIE_SECURE=false

