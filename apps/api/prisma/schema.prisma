generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @db.VarChar(120)
  email                 String                 @unique @db.VarChar(254)
  normalizedEmail       String                 @unique @db.VarChar(254)
  passwordHash          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  financialAccounts     FinancialAccount[]
  financialCategories   FinancialCategory[]
  financialTransactions FinancialTransaction[]
  financialTransfers    FinancialTransfer[]
  recurrenceRules       RecurrenceRule[]
  creditCards           FinancialCreditCard[]
  cardPurchases         CardPurchase[]
  cardInvoices          CardInvoice[]
  cardInvoicePayments   CardInvoicePayment[]
  financialDebts        FinancialDebt[]
  debtFundings          DebtFunding[]
  debtPayments          DebtPayment[]
  monthlyBudgets        MonthlyBudget[]
  transactionTemplates  TransactionTemplate[]
  preferences           UserPreferences?
  initialSetup          UserInitialSetup?
  setupConfirmations    SetupConfirmation[]
  importSessions        ImportSession[]
  importRows            ImportRow[]
  importConfirmations   ImportConfirmation[]
  notificationDevices   NotificationDevice[]
  capturedNotifications CapturedNotification[]
  notificationIngestions NotificationIngestConfirmation[]
}

enum NotificationDeviceStatus {
  ACTIVE
  REVOKED
}

enum CapturedNotificationStatus {
  UNCLASSIFIED
  FINANCIAL_CANDIDATE
  NON_FINANCIAL
  AMBIGUOUS
  IGNORED
  DISMISSED
  CONFIRMED
}

model NotificationDevice {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @db.Uuid
  deviceId          String                   @db.VarChar(80)
  ownerBindingId    String                   @unique @db.Uuid
  name              String?                  @db.VarChar(120)
  status            NotificationDeviceStatus @default(ACTIVE)
  captureEnabled    Boolean                  @default(false)
  monitoredPackages Json                     @default("[]")
  lastSeenAt        DateTime                 @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  notifications     CapturedNotification[]
  ingestions        NotificationIngestConfirmation[]

  @@unique([userId, deviceId])
  @@index([userId, status, lastSeenAt(sort: Desc)])
}

model CapturedNotification {
  id                  String                     @id @default(uuid()) @db.Uuid
  userId              String                     @db.Uuid
  deviceRecordId      String                     @db.Uuid
  deviceId            String                     @db.VarChar(80)
  ownerBindingId      String                     @db.Uuid
  packageName         String                     @db.VarChar(255)
  notificationKeyHash String                     @db.Char(64)
  fingerprintHash     String                     @db.Char(64)
  fingerprintVersion  Int                        @default(1)
  postedAt            DateTime                   @db.Timestamptz(3)
  capturedAt          DateTime                   @db.Timestamptz(3)
  receivedAt          DateTime                   @default(now()) @db.Timestamptz(3)
  title               String?                    @db.VarChar(300)
  text                String?                    @db.VarChar(1000)
  subText             String?                    @db.VarChar(300)
  bigText             String?                    @db.VarChar(4000)
  status              CapturedNotificationStatus @default(UNCLASSIFIED)
  classifierVersion   Int                        @default(0)
  parsedType          FinancialTransactionType?
  parsedAmount        Decimal?                   @db.Decimal(19, 2)
  parsedDescription   String?                    @db.VarChar(300)
  classificationReasons Json                     @default("[]")
  classifiedAt        DateTime?                  @db.Timestamptz(3)
  accountId           String?                    @db.Uuid
  categoryId          String?                    @db.Uuid
  confirmedTransactionId String?                 @unique @db.Uuid
  confirmedAt         DateTime?                  @db.Timestamptz(3)
  dismissedAt         DateTime?                  @db.Timestamptz(3)
  expiresAt           DateTime                   @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  device              NotificationDevice         @relation(fields: [deviceRecordId], references: [id], onDelete: Restrict)
  account             FinancialAccount?          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category            FinancialCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  confirmedTransaction FinancialTransaction?      @relation(fields: [confirmedTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, deviceId, packageName, notificationKeyHash, postedAt, fingerprintVersion])
  @@index([userId, status, receivedAt(sort: Desc)])
  @@index([expiresAt])
  @@index([fingerprintHash])
}

model NotificationIngestConfirmation {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  deviceRecordId String             @db.Uuid
  idempotencyKey String             @db.Uuid
  payloadHash    String             @db.Char(64)
  result         Json
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  device         NotificationDevice @relation(fields: [deviceRecordId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
}

enum UserAppearance {
  SYSTEM
  LIGHT
  DARK
}

enum UserAccent {
  BLUE
  TEAL
  PURPLE
  ORANGE
}

model UserPreferences {
  userId     String         @id @db.Uuid
  appearance UserAppearance @default(SYSTEM)
  accent     UserAccent     @default(BLUE)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
}

enum InitialSetupStatus {
  NOT_STARTED
  SKIPPED
  COMPLETED
}

model UserInitialSetup {
  userId             String             @id @db.Uuid
  status             InitialSetupStatus @default(NOT_STARTED)
  draft              Json?
  draftVersion       Int                @default(0)
  suggestionVersion  Int                @default(1)
  previewTokenHash   String?            @db.VarChar(64)
  previewPayloadHash String?            @db.VarChar(64)
  previewExpiresAt   DateTime?          @db.Timestamptz(3)
  completedAt        DateTime?          @db.Timestamptz(3)
  skippedAt          DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model SetupConfirmation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  idempotencyKey String   @db.Uuid
  payloadHash    String   @db.VarChar(64)
  result         Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId])
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

enum FinancialCategoryIcon {
  HOME
  WORK
  SHOPPING_CART
  RESTAURANT
  DIRECTIONS_CAR
  HEALTH_AND_SAFETY
  SCHOOL
  SAVINGS
}

model FinancialCategory {
  id                      String                  @id @default(uuid()) @db.Uuid
  userId                  String                  @db.Uuid
  name                    String                  @db.VarChar(80)
  normalizedName          String                  @db.VarChar(80)
  type                    FinancialCategoryType
  color                   String?                 @db.VarChar(7)
  icon                    FinancialCategoryIcon?
  archivedAt              DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  financialTransactions   FinancialTransaction[]
  recurrenceRules         RecurrenceRule[]
  cardPurchases           CardPurchase[]
  monthlyBudgetCategories MonthlyBudgetCategory[]
  transactionTemplates    TransactionTemplate[]
  importRows              ImportRow[]
  capturedNotifications   CapturedNotification[]

  @@unique([userId, type, normalizedName])
  @@index([userId])
}

model MonthlyBudget {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  month      String                  @db.Char(7)
  totalLimit Decimal                 @db.Decimal(19, 2)
  notes      String?                 @db.VarChar(2000)
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  categories MonthlyBudgetCategory[]

  @@unique([userId, month])
  @@index([userId])
}

model MonthlyBudgetCategory {
  id          String            @id @default(uuid()) @db.Uuid
  budgetId    String            @db.Uuid
  categoryId  String            @db.Uuid
  limitAmount Decimal           @db.Decimal(19, 2)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  budget      MonthlyBudget     @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
}

enum FinancialAccountType {
  CHECKING
  SAVINGS
  CASH
  PAYMENT
  OTHER
}

model FinancialAccount {
  id                         String                 @id @default(uuid()) @db.Uuid
  userId                     String                 @db.Uuid
  name                       String                 @db.VarChar(120)
  type                       FinancialAccountType
  institution                String?                @db.VarChar(120)
  currency                   String                 @db.Char(3)
  openingBalance             Decimal                @db.Decimal(19, 2)
  openingBalanceDate         DateTime               @db.Date
  archivedAt                 DateTime?              @db.Timestamptz(3)
  createdAt                  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @db.Timestamptz(3)
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  financialTransactions      FinancialTransaction[]
  transactionRecurrenceRules RecurrenceRule[]       @relation("RecurrenceAccount")
  sourceRecurrenceRules      RecurrenceRule[]       @relation("RecurrenceSourceAccount")
  destinationRecurrenceRules RecurrenceRule[]       @relation("RecurrenceDestinationAccount")
  outgoingTransfers          FinancialTransfer[]    @relation("TransferSourceAccount")
  incomingTransfers          FinancialTransfer[]    @relation("TransferDestinationAccount")
  cardInvoicePayments        CardInvoicePayment[]
  debtFundings               DebtFunding[]
  importSessions             ImportSession[]
  debtPayments               DebtPayment[]
  transactionTemplates       TransactionTemplate[]  @relation("TemplateDefaultAccount")
  capturedNotifications      CapturedNotification[]

  @@index([userId])
}

model TransactionTemplate {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @db.Uuid
  name             String                   @db.VarChar(80)
  normalizedName   String                   @db.VarChar(80)
  type             FinancialTransactionType
  categoryId       String                   @db.Uuid
  description      String                   @db.VarChar(200)
  plannedAmount    Decimal                  @db.Decimal(19, 2)
  defaultAccountId String?                  @db.Uuid
  notes            String?                  @db.VarChar(2000)
  dueDay           Int?
  archivedAt       DateTime?                @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category         FinancialCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultAccount   FinancialAccount?        @relation("TemplateDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: Restrict)

  @@unique([userId, normalizedName])
  @@index([userId, archivedAt, normalizedName, id])
  @@index([categoryId])
  @@index([defaultAccountId])
}

enum DebtType {
  LOAN
  FINANCING
  NEGOTIATED_DEBT
  OTHER
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
}

enum DebtInstallmentStatus {
  PENDING
  PAID
}

model FinancialDebt {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  type              DebtType
  creditorName      String            @db.VarChar(120)
  description       String?           @db.VarChar(200)
  notes             String?           @db.VarChar(2000)
  originalPrincipal Decimal           @db.Decimal(19, 2)
  startDate         DateTime          @db.Date
  installmentCount  Int
  status            DebtStatus        @default(ACTIVE)
  archivedAt        DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  funding           DebtFunding?
  installments      DebtInstallment[]
  payments          DebtPayment[]

  @@index([userId, archivedAt, status, type])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

model DebtFunding {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  debtId      String           @unique @db.Uuid
  accountId   String           @db.Uuid
  amount      Decimal          @db.Decimal(19, 2)
  fundingDate DateTime         @db.Date
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  debt        FinancialDebt    @relation(fields: [debtId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, accountId, fundingDate])
}

model DebtInstallment {
  id                String                @id @default(uuid()) @db.Uuid
  debtId            String                @db.Uuid
  installmentNumber Int
  dueDate           DateTime              @db.Date
  principalAmount   Decimal               @db.Decimal(19, 2)
  interestAmount    Decimal               @db.Decimal(19, 2)
  feeAmount         Decimal               @db.Decimal(19, 2)
  status            DebtInstallmentStatus @default(PENDING)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  debt              FinancialDebt         @relation(fields: [debtId], references: [id], onDelete: Restrict)
  payment           DebtPayment?

  @@unique([debtId, installmentNumber])
  @@index([debtId, status, dueDate, installmentNumber])
}

model DebtPayment {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  debtId          String           @db.Uuid
  installmentId   String           @unique @db.Uuid
  accountId       String           @db.Uuid
  paymentDate     DateTime         @db.Date
  principalAmount Decimal          @db.Decimal(19, 2)
  interestAmount  Decimal          @db.Decimal(19, 2)
  feeAmount       Decimal          @db.Decimal(19, 2)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  debt            FinancialDebt    @relation(fields: [debtId], references: [id], onDelete: Restrict)
  installment     DebtInstallment  @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, paymentDate(sort: Desc), id(sort: Desc)])
  @@index([userId, accountId, paymentDate])
  @@index([debtId, paymentDate(sort: Desc), id(sort: Desc)])
}

enum CardInvoiceStatus {
  OPEN
  CLOSED
  PAID
}

model FinancialCreditCard {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  name        String         @db.VarChar(120)
  issuer      String?        @db.VarChar(120)
  last4       String?        @db.Char(4)
  creditLimit Decimal?       @db.Decimal(19, 2)
  closingDay  Int
  dueDay      Int
  archivedAt  DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchases   CardPurchase[]
  invoices    CardInvoice[]

  @@index([userId, archivedAt, name, id])
}

model CardPurchase {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  cardId           String              @db.Uuid
  categoryId       String              @db.Uuid
  description      String              @db.VarChar(200)
  notes            String?             @db.VarChar(2000)
  purchaseDate     DateTime            @db.Date
  totalAmount      Decimal             @db.Decimal(19, 2)
  installmentCount Int
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  card             FinancialCreditCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  category         FinancialCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installments     CardInstallment[]

  @@index([userId, purchaseDate(sort: Desc), createdAt(sort: Desc), id])
  @@index([userId, cardId, purchaseDate])
  @@index([userId, categoryId, purchaseDate])
}

model CardInstallment {
  id                String       @id @default(uuid()) @db.Uuid
  purchaseId        String       @db.Uuid
  installmentNumber Int
  installmentCount  Int
  amount            Decimal      @db.Decimal(19, 2)
  referenceMonth    String       @db.Char(7)
  invoiceId         String       @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  purchase          CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  invoice           CardInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, installmentNumber])
  @@index([invoiceId])
  @@index([referenceMonth])
}

model CardInvoice {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  cardId         String              @db.Uuid
  referenceMonth String              @db.Char(7)
  closingDate    DateTime            @db.Date
  dueDate        DateTime            @db.Date
  status         CardInvoiceStatus   @default(OPEN)
  closedAt       DateTime?           @db.Timestamptz(3)
  paidAt         DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  card           FinancialCreditCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  installments   CardInstallment[]
  payment        CardInvoicePayment?

  @@unique([cardId, referenceMonth])
  @@index([userId, referenceMonth(sort: Desc), createdAt(sort: Desc), id])
  @@index([userId, cardId, status, referenceMonth])
}

model CardInvoicePayment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  invoiceId   String           @unique @db.Uuid
  accountId   String           @db.Uuid
  amount      Decimal          @db.Decimal(19, 2)
  paymentDate DateTime         @db.Date
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice     CardInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, paymentDate(sort: Desc), id])
  @@index([userId, accountId, paymentDate])
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum FinancialTransactionStatus {
  PENDING
  PAID
}

model FinancialTransaction {
  id               String                     @id @default(uuid()) @db.Uuid
  userId           String                     @db.Uuid
  accountId        String                     @db.Uuid
  categoryId       String                     @db.Uuid
  type             FinancialTransactionType
  status           FinancialTransactionStatus
  description      String                     @db.VarChar(200)
  notes            String?                    @db.VarChar(2000)
  plannedAmount    Decimal                    @db.Decimal(19, 2)
  actualAmount     Decimal?                   @db.Decimal(19, 2)
  dueDate          DateTime                   @db.Date
  paidAt           DateTime?                  @db.Date
  recurrenceRuleId String?                    @db.Uuid
  occurrenceDate   DateTime?                  @db.Date
  deletedAt        DateTime?                  @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(3)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  account          FinancialAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category         FinancialCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurrenceRule   RecurrenceRule?            @relation(fields: [recurrenceRuleId], references: [id], onDelete: Restrict)
  importRow        ImportRow?
  capturedNotification CapturedNotification?

  @@unique([recurrenceRuleId, occurrenceDate])
  @@index([userId, deletedAt, dueDate(sort: Desc), createdAt(sort: Desc), id])
  @@index([userId, deletedAt, status, dueDate])
  @@index([userId, deletedAt, paidAt])
  @@index([userId, dueDate(sort: Desc), createdAt(sort: Desc), id])
  @@index([userId, accountId, dueDate])
  @@index([userId, categoryId, dueDate])
  @@index([userId, status, dueDate])
  @@index([userId, paidAt])
}

enum ImportFormat {
  OFX
  CSV
}

enum ImportStatus {
  UPLOADED
  MAPPING_REQUIRED
  READY_FOR_REVIEW
  CONFIRMING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
}

enum ImportRowValidationStatus {
  VALID
  BLOCKED
}

enum ImportDuplicateClassification {
  NONE
  STRONG
  PROBABLE
  POSSIBLE
}

model ImportSession {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  accountId          String              @db.Uuid
  format             ImportFormat
  status             ImportStatus
  fileHash           String              @db.Char(64)
  parserVersion      String              @db.VarChar(32)
  displayFileName    String?             @db.VarChar(120)
  mapping            Json?
  sourceData         Json?
  draftVersion       Int                 @default(1)
  rowCount           Int                 @default(0)
  previewTokenHash   String?             @db.Char(64)
  previewPayloadHash String?             @db.Char(64)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  expiresAt          DateTime            @db.Timestamptz(3)
  confirmedAt        DateTime?           @db.Timestamptz(3)
  cancelledAt        DateTime?           @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  account            FinancialAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  rows               ImportRow[]
  confirmation       ImportConfirmation?

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, fileHash])
  @@index([status, expiresAt])
}

model ImportRow {
  id                      String                        @id @default(uuid()) @db.Uuid
  sessionId               String                        @db.Uuid
  userId                  String                        @db.Uuid
  rowNumber               Int
  date                    DateTime?                     @db.Date
  description             String?                       @db.VarChar(200)
  type                    FinancialTransactionType?
  amount                  Decimal?                      @db.Decimal(19, 2)
  externalId              String?                       @db.VarChar(255)
  categoryId              String?                       @db.Uuid
  selected                Boolean                       @default(false)
  validationStatus        ImportRowValidationStatus
  warningCodes            Json
  editedFields            Json
  probableOverride        Boolean                       @default(false)
  possibleAccepted        Boolean                       @default(false)
  strongKeyHash           String?                       @db.Char(64)
  exactFingerprint        String?                       @db.Char(64)
  windowFingerprint       String?                       @db.Char(64)
  fingerprintVersion      Int                           @default(1)
  duplicateClassification ImportDuplicateClassification @default(NONE)
  transactionId           String?                       @unique @db.Uuid
  createdAt               DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                      @updatedAt @db.Timestamptz(3)
  confirmedAt             DateTime?                     @db.Timestamptz(3)
  session                 ImportSession                 @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user                    User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  category                FinancialCategory?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transaction             FinancialTransaction?         @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, rowNumber])
  @@index([userId, sessionId, rowNumber])
  @@index([userId, strongKeyHash])
  @@index([userId, exactFingerprint])
  @@index([userId, windowFingerprint, date])
}

model ImportConfirmation {
  id             String        @id @default(uuid()) @db.Uuid
  sessionId      String        @unique @db.Uuid
  userId         String        @db.Uuid
  idempotencyKey String        @db.Uuid
  payloadHash    String        @db.Char(64)
  result         Json
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  session        ImportSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
}

enum FinancialTransferStatus {
  PENDING
  COMPLETED
}

model FinancialTransfer {
  id                   String                  @id @default(uuid()) @db.Uuid
  userId               String                  @db.Uuid
  sourceAccountId      String                  @db.Uuid
  destinationAccountId String                  @db.Uuid
  status               FinancialTransferStatus
  description          String                  @db.VarChar(200)
  notes                String?                 @db.VarChar(2000)
  plannedAmount        Decimal                 @db.Decimal(19, 2)
  actualAmount         Decimal?                @db.Decimal(19, 2)
  dueDate              DateTime                @db.Date
  completedAt          DateTime?               @db.Date
  recurrenceRuleId     String?                 @db.Uuid
  occurrenceDate       DateTime?               @db.Date
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceAccount        FinancialAccount        @relation("TransferSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   FinancialAccount        @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  recurrenceRule       RecurrenceRule?         @relation(fields: [recurrenceRuleId], references: [id], onDelete: Restrict)

  @@unique([recurrenceRuleId, occurrenceDate])
  @@index([userId, dueDate(sort: Desc), createdAt(sort: Desc), id])
  @@index([userId, sourceAccountId, dueDate])
  @@index([userId, destinationAccountId, dueDate])
  @@index([userId, status, dueDate])
  @@index([userId, completedAt])
}

enum RecurrenceKind {
  TRANSACTION
  TRANSFER
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceAttentionStatus {
  READY
  BLOCKED
}

enum RecurrenceBlockedReason {
  RELATED_RESOURCE_ARCHIVED
}

enum RecurrenceBlockedResourceType {
  ACCOUNT
  CATEGORY
}

model RecurrenceRule {
  id                   String                         @id @default(uuid()) @db.Uuid
  userId               String                         @db.Uuid
  kind                 RecurrenceKind
  status               RecurrenceStatus               @default(ACTIVE)
  frequency            RecurrenceFrequency
  startDate            DateTime                       @db.Date
  endDate              DateTime?                      @db.Date
  dayOfWeek            Int?
  dayOfMonth           Int?
  monthOfYear          Int?
  transactionType      FinancialTransactionType?
  accountId            String?                        @db.Uuid
  categoryId           String?                        @db.Uuid
  sourceAccountId      String?                        @db.Uuid
  destinationAccountId String?                        @db.Uuid
  plannedAmount        Decimal                        @db.Decimal(19, 2)
  description          String                         @db.VarChar(200)
  notes                String?                        @db.VarChar(2000)
  nextOccurrenceDate   DateTime?                      @db.Date
  attentionStatus      RecurrenceAttentionStatus      @default(READY)
  blockedReason        RecurrenceBlockedReason?
  blockedResourceType  RecurrenceBlockedResourceType?
  blockedResourceId    String?                        @db.Uuid
  blockedAt            DateTime?                      @db.Timestamptz(3)
  archivedAt           DateTime?                      @db.Timestamptz(3)
  createdAt            DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                       @updatedAt @db.Timestamptz(3)
  user                 User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  account              FinancialAccount?              @relation("RecurrenceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  category             FinancialCategory?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceAccount        FinancialAccount?              @relation("RecurrenceSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   FinancialAccount?              @relation("RecurrenceDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  transactions         FinancialTransaction[]
  transfers            FinancialTransfer[]

  @@index([userId, archivedAt, status, nextOccurrenceDate])
  @@index([userId, kind, frequency])
  @@index([accountId])
  @@index([categoryId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  refreshTokenDigest String
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
