generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  email           String    @unique @db.VarChar(254)
  normalizedEmail String    @unique @db.VarChar(254)
  passwordHash    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  financialAccounts FinancialAccount[]
  financialCategories FinancialCategory[]
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

enum FinancialCategoryIcon {
  HOME
  WORK
  SHOPPING_CART
  RESTAURANT
  DIRECTIONS_CAR
  HEALTH_AND_SAFETY
  SCHOOL
  SAVINGS
}

model FinancialCategory {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @db.Uuid
  name           String                  @db.VarChar(80)
  normalizedName String                  @db.VarChar(80)
  type           FinancialCategoryType
  color          String?                 @db.VarChar(7)
  icon           FinancialCategoryIcon?
  archivedAt     DateTime?               @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@unique([userId, type, normalizedName])
}

enum FinancialAccountType {
  CHECKING
  SAVINGS
  CASH
  PAYMENT
  OTHER
}

model FinancialAccount {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  name               String               @db.VarChar(120)
  type               FinancialAccountType
  institution        String?              @db.VarChar(120)
  currency           String               @db.Char(3)
  openingBalance     Decimal              @db.Decimal(19, 2)
  openingBalanceDate DateTime             @db.Date
  archivedAt         DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  refreshTokenDigest String
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
