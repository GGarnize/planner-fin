{
  "name": "@planner-fin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9000",
    "build": "vue-tsc -b && vite build",
    "build:prod": "node scripts/validate-prod-web-env.mjs && vue-tsc -b && vite build",
    "start:prod": "node scripts/serve-prod.mjs",
    "lint": "eslint src/**/*.{ts,vue} e2e/**/*.ts",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "android:validate": "node scripts/validate-android.mjs",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "pnpm android:sync && node scripts/build-android.mjs debug",
    "android:build:internal": "pnpm android:sync && node scripts/build-android.mjs internal",
    "android:release:build": "pnpm android:sync && node scripts/build-android-release.mjs",
    "android:release:publish": "node scripts/publish-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@planner-fin/shared": "workspace:*",
    "@planner-fin/storage": "workspace:*",
    "@quasar/extras": "^1.17.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "quasar": "^2.18.2",
    "vue": "^3.5.18",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.54.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
