{
  "name": "@planner-fin/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9000",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint src/**/*.{ts,vue} e2e/**/*.ts",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@planner-fin/shared": "workspace:*",
    "@quasar/extras": "^1.17.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "quasar": "^2.18.2",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
